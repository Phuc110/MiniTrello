# --- Database ---
DB_HOST=mysql
DB_PORT=3306
DB_NAME=mini_trello
DB_USERNAME=mini_trello_app
DB_PASSWORD=change_me
DB_POOL_SIZE=10

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# --- JWT --- (generate with: openssl rand -base64 64)
JWT_SECRET=change_me_to_a_long_random_base64_secret
JWT_ACCESS_EXPIRATION_MINUTES=15
JWT_REFRESH_EXPIRATION_DAYS=7

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Mail (dev: Mailtrap; prod: SES/SendGrid SMTP creds) ---
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true

# --- File storage ---
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./uploads
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Misc ---
SOFT_DELETE_PURGE_DAYS=30
RATE_LIMIT_RPM=60
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# --- Demo data --- (true seeds test accounts + a sample project on startup.
# Local/demo only — keep false for any production deployment.)
DEMO_DATA_ENABLED=true
