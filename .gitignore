# --- Environment / secrets (never commit real values) ---
.env
.env.*
!.env.example
!*.env.example

# --- IDE / editors ---
.idea/
*.iml
.vscode/
.vs/

# --- OS ---
.DS_Store
Thumbs.db

# --- Build output (backend/frontend have their own too) ---
target/
dist/
node_modules/

# --- Logs ---
*.log
logs/

# --- Uploads (keep the dir, ignore contents) ---
uploads/*
!uploads/.gitkeep

# --- Misc ---
HELP.md
*.local
